{
  "name": "bansimulator2000",
  "version": "1.0.1",
  "description": "Ban Simulator 2000",
  "main": "main.js",
  "scripts": {
    "start": "concurrently \"vite\" \"electron .\"",
    "build": "node prepare-build.js && vite build",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.seamusjj.bansimulator2000",
    "productName": "Ban Simulator 2000",
    "files": [
      "dist/**/*",
      "main.js",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "SeamusJJ",
        "repo": "BanSimulator2000Updater"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "vite": "^8.3.0"
  }
}
